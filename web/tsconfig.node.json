{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* vite.config.ts imports these, so they are compiled under this project too
   * — they must stay DOM-free and must not use the `@/*` alias, which is only
   * mapped in tsconfig.app.json. */
  "include": ["vite.config.ts", "src/pwa/manifest.ts", "src/brand.ts", "src/shell/canvas.ts"]
}
