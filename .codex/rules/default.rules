prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push can clobber sibling-worktree commits; use --force-with-lease.",
    match = ["git push --force origin feature/example"],
    not_match = ["git push --force-with-lease origin feature/example"],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Short-form force-push is forbidden; use --force-with-lease.",
    match = ["git push -f origin feature/example"],
    not_match = ["git push --force-with-lease origin feature/example"],
)
