#!/usr/bin/env bash
set -euo pipefail
url="${1:?url required}"
prof="${CCSWITCH_REAUTH_PROFILE:?CCSWITCH_REAUTH_PROFILE required}"
# the profile MUST be under the ccswitch reauth-tmp dir.
# Derive the root identically to paths.root(): CCSWITCH_HOME or ~/.claude-accounts.
reauth_root="${CCSWITCH_HOME:-$HOME/.claude-accounts}/reauth-tmp/"
case "$prof" in
  "$reauth_root"*) : ;;
  *) echo "ccswitch-reauth-browser: refusing profile outside reauth-tmp: $prof (allowed: $reauth_root)" >&2; exit 2 ;;
esac
bin="${CCSWITCH_REAUTH_BROWSER_BIN:-}"
if [ -z "$bin" ]; then
  for c in google-chrome google-chrome-stable chromium chromium-browser; do
    if command -v "$c" >/dev/null 2>&1; then bin="$c"; break; fi
  done
fi
[ -n "$bin" ] || { echo "ccswitch-reauth-browser: no supported browser found" >&2; exit 3; }
echo $$ > "$prof/launcher.pid" 2>/dev/null || true
# Anti-throttling flags are CRITICAL: launched from a background service the window
# is often unfocused/occluded, and Chrome then backgrounds the renderer and throttles
# JS timers to ~1/min. claude.com's consent page enables the "Authorize" button via a
# JS timer, so throttling makes it take minutes to go gray→black. These flags (the same
# set automation/kiosk Chrome uses) keep the renderer running at full speed regardless
# of focus/occlusion. The --disable-background-networking group also speeds the cold
# fresh-profile start (no Finch/component/safe-browsing fetches competing with the page).
exec "$bin" \
  --user-data-dir="$prof" \
  --password-store=gnome-libsecret \
  --no-first-run --no-default-browser-check \
  --disable-renderer-backgrounding \
  --disable-backgrounding-occluded-windows \
  --disable-background-timer-throttling \
  --disable-features=CalculateNativeWinOcclusion \
  --disable-background-networking \
  --disable-component-update \
  --disable-sync \
  --disable-client-side-phishing-detection \
  --metrics-recording-only \
  --new-window "$url"
