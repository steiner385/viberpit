.claude.json
.credentials.json
.coverage

# pytest --junitxml output at repo root (e.g. PYTHONPATH=.:src pytest --junitxml=test-results/core.xml)
test-results/

# Impeccable (design skill, .claude/README.md § Impeccable): the installer drops a
# 16 MB native engine binary next to the skill; the launcher re-fetches it
# (sha256-verified) into ~/.impeccable when absent. `.impeccable/` is its per-run
# scratch (comps, review screenshots, build state).
.agents/skills/impeccable/scripts/bin/
.claude/skills/impeccable/scripts/bin/
.impeccable/

# web/ frontend
web/node_modules
web/dist
web/.playwright
web/playwright-report
web/test-results
