# ccswitch web backend — copy to .env and fill in values

# Host the server binds to (default: 127.0.0.1)
# CCSWITCH_HOST=127.0.0.1

# Port the server listens on (default: 8787)
# CCSWITCH_PORT=8787

# SQLAlchemy async database URL
# Defaults to sqlite+aiosqlite:///$HOME/.claude-accounts/ccswitch.db
# CCSWITCH_DB_URL=sqlite+aiosqlite:////path/to/ccswitch.db

# Master encryption key used to protect stored credentials (required in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CCSWITCH_MASTER_KEY=

# Comma-separated list of Tailscale node names or IPs allowed to reach the API
# Leave empty to allow all (default: no restriction)
# CCSWITCH_TAILNET_ALLOWLIST=my-node,another-node

# Structured logging
CCSWITCH_LOG_LEVEL=INFO
CCSWITCH_LOG_DIR=/var/log/ccswitch
CCSWITCH_CLIENT_LOG_LEVEL=warn

# --- Cross-host session daemon (mTLS) — optional, P4 public hosting (#205) ---
# Default is same-host over a Unix socket; leave these unset for that.
# CCSWITCH_SESSIOND_ENDPOINT=https://daemon.example.ts.net:9443
# Daemon (server) side — presents server cert, verifies client certs against the CA:
# CCSWITCH_SESSIOND_TLS_CERT=/etc/ccswitch/tls/server.pem
# CCSWITCH_SESSIOND_TLS_KEY=/etc/ccswitch/tls/server.key
# CCSWITCH_SESSIOND_TLS_CA=/etc/ccswitch/tls/ca.pem
# Edge (client) side — presents client cert, verifies server cert against the CA:
# CCSWITCH_SESSIOND_CLIENT_CERT=/etc/ccswitch/tls/client.pem
# CCSWITCH_SESSIOND_CLIENT_KEY=/etc/ccswitch/tls/client.key
# CCSWITCH_SESSIOND_CLIENT_CA=/etc/ccswitch/tls/ca.pem
