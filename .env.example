# ccswitch web backend — copy to .env and fill in values
#
# Every CCSWITCH_* name below may equivalently be spelled VIBERPIT_* (ViberPit rebrand):
# each entrypoint mirrors the two prefixes into each other at startup, filling only names
# that are unset. Setting both to different values is not an error — each keeps the value
# the process was launched with — but it is a good way to confuse yourself. Pick one.

# Host the server binds to (default: 127.0.0.1)
# CCSWITCH_HOST=127.0.0.1

# Port the server listens on (default: 8787)
# CCSWITCH_PORT=8787

# SQLAlchemy async database URL
# Defaults to sqlite+aiosqlite:///$HOME/.claude-accounts/ccswitch.db
# CCSWITCH_DB_URL=sqlite+aiosqlite:////path/to/ccswitch.db

# Master encryption key used to protect stored credentials (required in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CCSWITCH_MASTER_KEY=

# Comma-separated list of Tailscale node names or IPs allowed to reach the API
# Leave empty to allow all (default: no restriction)
# CCSWITCH_TAILNET_ALLOWLIST=my-node,another-node

# Peers permitted to ASSERT an identity via the Tailscale-User-Login header.
# Loopback (127.0.0.1 / ::1) is ALWAYS trusted: `tailscale serve` terminates the
# tailnet connection and proxies to the edge's loopback bind, so that is where a
# genuinely stamped header comes from. A header presented by any other peer is an
# unverified claim and is ignored (the request falls through to `tailscale whois`).
# Accepts single addresses and CIDR ranges. Only set this if something else
# legitimately stamps the header — e.g. a reverse proxy or container gateway on a
# fixed address. Anything matching can claim to be ANY user, so list only addresses
# you control and keep ranges as narrow as possible. A malformed entry is logged and
# skipped rather than failing the gate open or shut.
# CCSWITCH_TRUSTED_PROXY_IPS=172.17.0.1,10.0.0.0/24

# LAN-open mode (default: false) — DANGEROUS. When enabled, clients that present
# NO Tailscale identity (e.g. a plain LAN browser reaching http://<host>.local:8787)
# are admitted UNAUTHENTICATED as a synthetic "lan@local" guest instead of 401'd.
# Only enable on a fully trusted, isolated network: ANY device that can reach the
# port gains full control of your Claude sessions. Presented Tailscale identities are
# still subject to CCSWITCH_TAILNET_ALLOWLIST. Pair with CCSWITCH_HOST=0.0.0.0.
# CCSWITCH_ALLOW_UNAUTHENTICATED=false

# Archive storage path (optional)
# Override where archived session working directories are stored.
# Defaults to $CCSWITCH_HOME/archive. Set to a path on a larger/slower drive
# to keep live session data and archives on separate filesystems.
# CCSWITCH_ARCHIVE_HOME=/mnt/slow-drive/ccswitch-archives

# Structured logging
CCSWITCH_LOG_LEVEL=INFO
CCSWITCH_LOG_DIR=/var/log/ccswitch
CCSWITCH_CLIENT_LOG_LEVEL=warn

# Event-loop stall stack dumps (#762). The loop-lag watchdog measures how long the
# event loop is blocked, but only a stack taken *during* the block names the culprit.
# When the loop blocks longer than this many seconds, faulthandler's timer thread
# dumps every thread's stack (default: 10s; set 0 to disable).
# CCSWITCH_LOOP_STALL_DUMP_S=10
# Where those dumps go. Unset = the process stderr / journal (recommended). Set a
# path to append them to a dedicated file instead (e.g. /tmp/daemon-stalls.txt).
# CCSWITCH_LOOP_STALL_DUMP_PATH=/tmp/daemon-stalls.txt

# --- Cross-host session daemon (mTLS) — optional, P4 public hosting (#205) ---
# Default is same-host over a Unix socket; leave these unset for that.
# CCSWITCH_SESSIOND_ENDPOINT=https://daemon.example.ts.net:9443
# Daemon (server) side — presents server cert, verifies client certs against the CA:
# CCSWITCH_SESSIOND_TLS_CERT=/etc/ccswitch/tls/server.pem
# CCSWITCH_SESSIOND_TLS_KEY=/etc/ccswitch/tls/server.key
# CCSWITCH_SESSIOND_TLS_CA=/etc/ccswitch/tls/ca.pem
# Edge (client) side — presents client cert, verifies server cert against the CA:
# CCSWITCH_SESSIOND_CLIENT_CERT=/etc/ccswitch/tls/client.pem
# CCSWITCH_SESSIOND_CLIENT_KEY=/etc/ccswitch/tls/client.key
# CCSWITCH_SESSIOND_CLIENT_CA=/etc/ccswitch/tls/ca.pem
# Optional client-cert identity allowlist for the cross-host mTLS daemon.
# Comma-separated CN/SAN values. UNSET = any CA-signed client cert is accepted (v1).
# When set, a CA-signed client whose CN/SAN is not listed fails the TLS handshake.
# CCSWITCH_SESSIOND_CLIENT_ALLOWLIST=edge.internal

# --- Fleet: targeted session runners ---
# rocky is the SOLE targeted session runner in the deployed topology. dobby is the
# edge/master (this web process) and its local ccswitch-daemon is deliberately disabled.
# Two env vars pin rocky and MUST name the same host to stay consistent:
#
# 1) Deploy target — the remote daemon whose checkout is updated + restarted on deploy
#    (server/deploy/steps.py::restart_units). Requires the checkout path on the remote.
# CCSWITCH_DAEMON_SSH_HOST=tony@rocky.tail0dd570.ts.net
# CCSWITCH_DAEMON_SSH_REPO=/home/tony/GitHub/ccswitch
#
# 2) Registry seed — inserts rocky into the host registry so the dispatcher can rank and
#    route to it (server/config.py fleet_hosts; insert-if-absent, Fleet-UI edits survive).
# CCSWITCH_FLEET_HOSTS=rocky=https://rocky.tail0dd570.ts.net:9443
#
# Two-host expansion (add dobby back as a runner) is a supported config flip, not a code
# change — the ranking/routing code is already N-host:
# CCSWITCH_FLEET_HOSTS=rocky=https://rocky.tail0dd570.ts.net:9443,dobby=https://dobby:9443

# --- Account re-authentication (Chrome login flow) ---
# The reauth flow copies a Chrome profile into a throwaway directory under
# ~/.claude-accounts/reauth-tmp/ and drives a browser with it. Everything below is
# about how much of the source profile travels into that copy (#1105).
#
# Source profile. Defaults to a dedicated, ccswitch-owned profile
# (~/.claude-accounts/chrome-profile/Default). Pointing it at your everyday Chrome
# profile puts every cookie and saved password it holds one missed cleanup away
# from reauth-tmp — opt in only if you understand that.
# CCSWITCH_CHROME_PROFILE=/home/you/.config/google-chrome/Default
#
# Cookie ALLOWLIST (comma-separated registrable domains). Unset = no cookies are
# carried at all, which is what the OAuth login needs. Listing a domain re-presents
# that session from a fresh profile with a different fingerprint, several times per
# retry burst — the pattern session-risk heuristics score as a hijack, and the
# reason the operator's own Google session kept being invalidated. Claude/Anthropic
# cookies are always dropped so the login starts signed out.
# CCSWITCH_REAUTH_COOKIE_HOSTS=google.com
#
# Copy the source profile's saved-password database. An OAuth login never needs it;
# it exists only to fill a login form from Chrome's own password manager.
# CCSWITCH_REAUTH_COPY_LOGIN_DATA=true
#
# Extension ids carried into the login profile (comma list). Unset = 1Password;
# set-but-empty = none.
# CCSWITCH_REAUTH_EXTENSIONS=
