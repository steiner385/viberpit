# ccswitch web backend — copy to .env and fill in values

# Host the server binds to (default: 127.0.0.1)
# CCSWITCH_HOST=127.0.0.1

# Port the server listens on (default: 8787)
# CCSWITCH_PORT=8787

# SQLAlchemy async database URL
# Defaults to sqlite+aiosqlite:///$HOME/.claude-accounts/ccswitch.db
# CCSWITCH_DB_URL=sqlite+aiosqlite:////path/to/ccswitch.db

# Master encryption key used to protect stored credentials (required in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CCSWITCH_MASTER_KEY=

# Comma-separated list of Tailscale node names or IPs allowed to reach the API
# Leave empty to allow all (default: no restriction)
# CCSWITCH_TAILNET_ALLOWLIST=my-node,another-node

# LAN-open mode (default: false) — DANGEROUS. When enabled, clients that present
# NO Tailscale identity (e.g. a plain LAN browser reaching http://<host>.local:8787)
# are admitted UNAUTHENTICATED as a synthetic "lan@local" guest instead of 401'd.
# Only enable on a fully trusted, isolated network: ANY device that can reach the
# port gains full control of your Claude sessions. Presented Tailscale identities are
# still subject to CCSWITCH_TAILNET_ALLOWLIST. Pair with CCSWITCH_HOST=0.0.0.0.
# CCSWITCH_ALLOW_UNAUTHENTICATED=false

# Archive storage path (optional)
# Override where archived session working directories are stored.
# Defaults to $CCSWITCH_HOME/archive. Set to a path on a larger/slower drive
# to keep live session data and archives on separate filesystems.
# CCSWITCH_ARCHIVE_HOME=/mnt/slow-drive/ccswitch-archives

# Structured logging
CCSWITCH_LOG_LEVEL=INFO
CCSWITCH_LOG_DIR=/var/log/ccswitch
CCSWITCH_CLIENT_LOG_LEVEL=warn

# Event-loop stall stack dumps (#762). The loop-lag watchdog measures how long the
# event loop is blocked, but only a stack taken *during* the block names the culprit.
# When the loop blocks longer than this many seconds, faulthandler's timer thread
# dumps every thread's stack (default: 10s; set 0 to disable).
# CCSWITCH_LOOP_STALL_DUMP_S=10
# Where those dumps go. Unset = the process stderr / journal (recommended). Set a
# path to append them to a dedicated file instead (e.g. /tmp/daemon-stalls.txt).
# CCSWITCH_LOOP_STALL_DUMP_PATH=/tmp/daemon-stalls.txt

# --- Cross-host session daemon (mTLS) — optional, P4 public hosting (#205) ---
# Default is same-host over a Unix socket; leave these unset for that.
# CCSWITCH_SESSIOND_ENDPOINT=https://daemon.example.ts.net:9443
# Daemon (server) side — presents server cert, verifies client certs against the CA:
# CCSWITCH_SESSIOND_TLS_CERT=/etc/ccswitch/tls/server.pem
# CCSWITCH_SESSIOND_TLS_KEY=/etc/ccswitch/tls/server.key
# CCSWITCH_SESSIOND_TLS_CA=/etc/ccswitch/tls/ca.pem
# Edge (client) side — presents client cert, verifies server cert against the CA:
# CCSWITCH_SESSIOND_CLIENT_CERT=/etc/ccswitch/tls/client.pem
# CCSWITCH_SESSIOND_CLIENT_KEY=/etc/ccswitch/tls/client.key
# CCSWITCH_SESSIOND_CLIENT_CA=/etc/ccswitch/tls/ca.pem
# Optional client-cert identity allowlist for the cross-host mTLS daemon.
# Comma-separated CN/SAN values. UNSET = any CA-signed client cert is accepted (v1).
# When set, a CA-signed client whose CN/SAN is not listed fails the TLS handshake.
# CCSWITCH_SESSIOND_CLIENT_ALLOWLIST=edge.internal
