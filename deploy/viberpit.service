[Unit]
Description=ViberPit web — multi-account Claude session manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=viberpit
User=tony
# Per-HOST log dir (/var/log/viberpit), created and chowned to User= by systemd.
# The edge and the daemon must not share one file: they are separate processes and
# on the deployed fleet separate HOSTS, and the pre-#1010 default put both in the
# sshfs-shared account store. See server/obs/logdir.py.
LogsDirectory=viberpit
WorkingDirectory=/home/tony/GitHub/viberpit-deploy
# Runtime secrets/config (DB url, signing keys, tailnet allowlist) + PATH/HOME so
# the server can find git/node/claude. Created out-of-band; NOT in the repo.
EnvironmentFile=/etc/viberpit/viberpit.env
# --timeout-graceful-shutdown bounds how long uvicorn waits for open connections
# (attached browser WebSockets never close on their own) before forcing them shut.
# Without it, SIGTERM hangs indefinitely, the lifespan shutdown branch in
# server/app.py (session close, X11 sweep, DB dispose — see app.py's shutdown
# comment block) NEVER runs, and systemd SIGKILLs at TimeoutStopSec on every deploy
# (transcript audit V4).
# --timeout-keep-alive: without it uvicorn defaults to 5s, tied with the assistant
# loopback client's httpx pool (server/assistant/client.py), which also defaults to
# 5s. Equal timers race at the boundary and the client can hit "Server disconnected
# without sending a response" from this healthy process (#1614/#1632 keepalive
# audit). Set to server/http_keepalive.py's SERVER_KEEPALIVE_TIMEOUT_S so it stays
# well above every client pool's CLIENT_KEEPALIVE_EXPIRY_S.
ExecStart=/home/tony/GitHub/viberpit-deploy/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8787 --timeout-graceful-shutdown 10 --timeout-keep-alive 30
Restart=on-failure
RestartSec=3
# Chromium is slow to exit; cap host resources on the 19GB box
# Shutdown budget: 10s (--timeout-graceful-shutdown, above) + up to 45s worst case
# for the app.py lifespan shutdown branch (_SHUTDOWN_CLOSE_TIMEOUT_S=30 +
# _SHUTDOWN_SWEEP_TIMEOUT_S=15, sequential, in-process-fallback mode only — remote
# mode's shutdown is just an IPC client close) + small overhead for the reauth/
# auth-audit stop calls = ~55-60s, comfortably under the 90s below.
TimeoutStopSec=90
KillMode=control-group
MemoryMax=12G
# No pids ceiling: in the in-process fallback (daemon unreachable) the edge runs
# sessions itself, each spawning a Claude CLI + MCP fleet + Xvfb + threads. TasksMax
# counts threads, so a low cap throttles fork/thread spawns (EAGAIN). Kept in sync
# with viberpit-daemon.service; MemoryMax=12G is the real backstop.
TasksMax=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
Alias=ccswitch.service
