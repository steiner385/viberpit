# ccswitch session daemon for a REMOTE session host (e.g. rocky), reached by the
# edge over mTLS instead of a Unix socket. Install as ccswitch-daemon.service ON
# THE REMOTE HOST; dobby keeps deploy/ccswitch-daemon.service for the local case.
#
# The endpoint, TLS material and client allowlist all come from
# /etc/ccswitch/ccswitch.env — an https:// endpoint with missing TLS files fails
# loud at startup rather than falling back to plaintext.
[Unit]
Description=ccswitch session daemon (remote host) — owns live claude sessions
After=network-online.target tailscaled.service
Wants=network-online.target
# The database is reached over the tailnet, so tailscaled must be up first.
Requires=tailscaled.service

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccswitch-daemon
User=tony
RuntimeDirectory=ccswitch
RuntimeDirectoryPreserve=yes
StateDirectory=ccswitch
WorkingDirectory=/home/tony/GitHub/ccswitch
EnvironmentFile=/etc/ccswitch/ccswitch.env
ExecStart=/home/tony/GitHub/ccswitch/.venv/bin/python -m server.ipc
# Restart=always, NOT on-failure: an out-of-band SIGTERM exits with Result=success,
# which on-failure does NOT restart — the daemon would then stay dead and the edge
# would loop on connection refused. Same rationale as the local unit.
Restart=always
RestartSec=3
TimeoutStopSec=90
KillMode=control-group
# Sized for rocky's 31 GB, versus 10G/12G on dobby's 19 GB host. Memory headroom is
# the main reason for offloading sessions here in the first place.
MemoryHigh=24G
MemoryMax=28G
# TasksMax counts threads: this daemon owns every live claude session plus its MCP
# fleet, Xvfb and thread pools. MemoryMax is the real backstop.
TasksMax=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
