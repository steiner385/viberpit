[Unit]
Description=ccswitch web — multi-account Claude session manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tony
WorkingDirectory=/mnt/ssk-ssd/tony/GitHub/cc-account-switcher
# Runtime secrets/config (DB url, signing keys, tailnet allowlist) + PATH/HOME so
# the server can find git/node/claude. Created out-of-band; NOT in the repo.
EnvironmentFile=/etc/ccswitch/ccswitch.env
ExecStart=/mnt/ssk-ssd/tony/GitHub/cc-account-switcher/.venv/bin/uvicorn server.app:app --host 100.102.11.121 --port 8787
Restart=on-failure
RestartSec=3
# Chromium is slow to exit; cap host resources on the 19GB box
TimeoutStopSec=60
KillMode=control-group
MemoryMax=12G
# No pids ceiling: in the in-process fallback (daemon unreachable) the edge runs
# sessions itself, each spawning a Claude CLI + MCP fleet + Xvfb + threads. TasksMax
# counts threads, so a low cap throttles fork/thread spawns (EAGAIN). Kept in sync
# with ccswitch-daemon.service; MemoryMax=12G is the real backstop.
TasksMax=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
