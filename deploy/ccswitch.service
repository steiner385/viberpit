[Unit]
Description=ccswitch web — multi-account Claude session manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccswitch
User=tony
WorkingDirectory=/home/tony/GitHub/cc-account-switcher-deploy
# Runtime secrets/config (DB url, signing keys, tailnet allowlist) + PATH/HOME so
# the server can find git/node/claude. Created out-of-band; NOT in the repo.
EnvironmentFile=/etc/ccswitch/ccswitch.env
# --timeout-graceful-shutdown bounds how long uvicorn waits for open connections
# (attached browser WebSockets never close on their own) before forcing them shut.
# Without it, SIGTERM hangs indefinitely, the lifespan shutdown branch in
# server/app.py (session close, X11 sweep, DB dispose — see app.py's shutdown
# comment block) NEVER runs, and systemd SIGKILLs at TimeoutStopSec on every deploy
# (transcript audit V4).
ExecStart=/home/tony/GitHub/cc-account-switcher-deploy/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8787 --timeout-graceful-shutdown 10
Restart=on-failure
RestartSec=3
# Chromium is slow to exit; cap host resources on the 19GB box
# Shutdown budget: 10s (--timeout-graceful-shutdown, above) + up to 45s worst case
# for the app.py lifespan shutdown branch (_SHUTDOWN_CLOSE_TIMEOUT_S=30 +
# _SHUTDOWN_SWEEP_TIMEOUT_S=15, sequential, in-process-fallback mode only — remote
# mode's shutdown is just an IPC client close) + small overhead for the reauth/
# auth-audit stop calls = ~55-60s, comfortably under the 90s below.
TimeoutStopSec=90
KillMode=control-group
MemoryMax=12G
# No pids ceiling: in the in-process fallback (daemon unreachable) the edge runs
# sessions itself, each spawning a Claude CLI + MCP fleet + Xvfb + threads. TasksMax
# counts threads, so a low cap throttles fork/thread spawns (EAGAIN). Kept in sync
# with ccswitch-daemon.service; MemoryMax=12G is the real backstop.
TasksMax=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
