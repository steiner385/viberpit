[Unit]
Description=ccswitch session daemon — owns live claude sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccswitch-daemon
User=tony
RuntimeDirectory=ccswitch
RuntimeDirectoryPreserve=yes
# Persistent state dir owned by User= (creates /var/lib/ccswitch). The deploy
# snapshot/restore (issue: user-controlled deploy) writes the live-session snapshot
# under here; without it the non-root daemon can't create /var/lib/ccswitch and
# snapshot_deploy fails with PermissionError.
StateDirectory=ccswitch
WorkingDirectory=/mnt/ssk-ssd/tony/GitHub/cc-account-switcher
EnvironmentFile=/etc/ccswitch/ccswitch.env
ExecStart=/mnt/ssk-ssd/tony/GitHub/cc-account-switcher/.venv/bin/python -m server.ipc
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
KillMode=control-group
MemoryMax=12G
# Soft limit below MemoryMax: at 10G the kernel applies reclaim pressure and throttles
# the cgroup instead of hard-stopping it (OOMPolicy=stop) at 12G. Gives a restart-storm
# of relaunched session+MCP fleets a chance to bleed off rather than killing the daemon
# outright. The health watchdog (ccswitch-health.timer) alerts before this is reached.
MemoryHigh=10G
# No pids ceiling: this daemon owns every live claude session, and each spawns a
# Claude CLI + its MCP-server fleet + Xvfb + thread pools. TasksMax counts threads
# too, so a low cap is hit fast (512 throttled ~900x in prod → fork/thread EAGAIN,
# SIGABRT'd subprocesses, dead turns). MemoryMax=12G is the real backstop.
TasksMax=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
