[Unit]
Description=ccswitch session daemon — owns live claude sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccswitch-daemon
User=tony
RuntimeDirectory=ccswitch
RuntimeDirectoryPreserve=yes
# Persistent state dir owned by User= (creates /var/lib/ccswitch). The deploy
# snapshot/restore (issue: user-controlled deploy) writes the live-session snapshot
# under here; without it the non-root daemon can't create /var/lib/ccswitch and
# snapshot_deploy fails with PermissionError.
StateDirectory=ccswitch
WorkingDirectory=/home/tony/GitHub/cc-account-switcher-deploy
EnvironmentFile=/etc/ccswitch/ccswitch.env
# This entrypoint calls uvicorn.run() programmatically (server/ipc/serve.py) rather
# than the uvicorn CLI, so --timeout-graceful-shutdown can't be passed here as a
# flag; it's set as timeout_graceful_shutdown=10 in that call instead (same
# transcript-audit V4 rationale as ccswitch.service: bound SIGTERM so the daemon
# lifespan shutdown — x11 teardown, reauth shutdown, orchestrator stop — actually
# runs instead of being SIGKILLed).
ExecStart=/home/tony/GitHub/cc-account-switcher-deploy/.venv/bin/python -m server.ipc
# Restart=always, NOT on-failure: an out-of-band SIGTERM (a stray kill/pkill, not a
# `systemctl stop`) makes the daemon exit with Result=success, which on-failure does
# NOT restart — the daemon then stays dead, the edge loops on "Connection refused",
# and the UI shows no sessions. The health watchdog only covers the wedge case
# (process alive, socket dead), so a fully-absent daemon fell between both guards.
# `always` still honors an explicit `systemctl stop` (deploys are unaffected), and
# StartLimitBurst/Interval still backstops a genuine crash-loop.
Restart=always
RestartSec=3
# Shutdown budget. SIGTERM first DRAINS in-flight turns (server/ipc/drain_on_signal.py,
# 2026-08-30: a bare `systemctl restart` killed five sessions mid-turn) — up to
# CCSWITCH_DRAIN_TURN_CAP_SEC (180s) for an ordinary turn, or
# CCSWITCH_DRAIN_CONDENSE_CAP_SEC (570s) while a session is mid-compaction — and only
# then begins the ordinary shutdown: 10s (uvicorn graceful) + up to 15s (x11.stop_all
# sweep, _DAEMON_SHUTDOWN_SWEEP_TIMEOUT_S in serve.py) + reauth shutdown/orchestrator
# stop. 570 + 90 = 660. An idle daemon still stops in seconds; a WEDGED one (loop not
# running, so the drain never starts) is what the health watchdog escalates with
# SIGKILL after CCSWITCH_DRAIN_WAIT rather than waiting this out.
TimeoutStopSec=660
# mixed, NOT control-group: control-group SIGTERMs every live claude child in
# parallel with the daemon, so their turns die with exit 143 BEFORE stop() can
# set _shutting_down — each was persisted as needs_attention and survived the
# restart as a spurious "Turn failed" card (2026-08-29). mixed SIGTERMs only the
# daemon; orchestrator.stop() then tears children down in order, and the final
# SIGKILL phase still sweeps the whole cgroup at TimeoutStopSec.
KillMode=mixed
MemoryMax=12G
# Soft limit below MemoryMax: at 10G the kernel applies reclaim pressure and throttles
# the cgroup instead of hard-stopping it (OOMPolicy=stop) at 12G. Gives a restart-storm
# of relaunched session+MCP fleets a chance to bleed off rather than killing the daemon
# outright. The health watchdog (ccswitch-health.timer) alerts before this is reached.
MemoryHigh=10G
# No pids ceiling: this daemon owns every live claude session, and each spawns a
# Claude CLI + its MCP-server fleet + Xvfb + thread pools. TasksMax counts threads
# too, so a low cap is hit fast (512 throttled ~900x in prod → fork/thread EAGAIN,
# SIGABRT'd subprocesses, dead turns). MemoryMax=12G is the real backstop.
TasksMax=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
