# viberpit session daemon for a REMOTE session host (e.g. rocky), reached by the
# edge over mTLS instead of a Unix socket. Install as viberpit-daemon.service ON
# THE REMOTE HOST; dobby keeps deploy/viberpit-daemon.service for the local case.
#
# The endpoint, TLS material and client allowlist all come from
# /etc/viberpit/viberpit.env — an https:// endpoint with missing TLS files fails
# loud at startup rather than falling back to plaintext.
[Unit]
Description=ViberPit session daemon (remote host) — owns live claude sessions
After=network-online.target tailscaled.service
Wants=network-online.target
# The database is reached over the tailnet, so tailscaled must be up first.
Requires=tailscaled.service

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=viberpit-daemon
User=tony
RuntimeDirectory=viberpit
RuntimeDirectoryPreserve=yes
StateDirectory=viberpit
WorkingDirectory=/home/tony/GitHub/viberpit
EnvironmentFile=/etc/viberpit/viberpit.env
# Where per-account CODEX_HOMEs land: /var/lib/viberpit/state/ccswitch/codex.
# This matters MORE on a remote runner than on dobby: this host mounts shared
# viberpit config over sshfs, and `codex app-server` keeps SQLite + WAL, thread
# state and shell history under CODEX_HOME. Putting that on a FUSE mount is the
# 2026-09-03 torn-read incident (#1005) applied to a file format that assumes
# local locking. StateDirectory= is host-local by construction, so locality stops
# depending on where $HOME/.local/state happens to resolve here. XDG_STATE_HOME
# has exactly ONE reader in this repo
# (server/codex/manager.py:default_codex_home_base), so this moves nothing else.
Environment=XDG_STATE_HOME=%S/viberpit/state
# Boot-time version reconcile (spec: fleet deploy fan-out §3): fast-forward this checkout to
# deploy_state.deployed_sha when it is behind. Always exits 0 — a runner that cannot
# reconcile still starts; the edge's skew gate keeps it out of dispatch until fixed.
# The leading `-` makes systemd IGNORE a non-zero exit AND a missing module: a checkout that
# predates server/deploy/runner_sync.py — the bootstrap window before this commit is deployed,
# or a rollback that rewinds across it — would otherwise fail ExecStartPre and never start
# the daemon at all.
ExecStartPre=-/home/tony/GitHub/viberpit/.venv/bin/python -m server.deploy.runner_sync --repo /home/tony/GitHub/viberpit
ExecStart=/home/tony/GitHub/viberpit/.venv/bin/python -m server.ipc
# Startup budget: the ExecStartPre reconcile can fetch (60s) + pip install (600s) + sync (120s)
# before ExecStart even begins, well past systemd's 90s default.
TimeoutStartSec=900
# Restart=always, NOT on-failure: an out-of-band SIGTERM exits with Result=success,
# which on-failure does NOT restart — the daemon would then stay dead and the edge
# would loop on connection refused. Same rationale as the local unit.
Restart=always
RestartSec=3
# SIGTERM drains in-flight turns first (server/ipc/drain_on_signal.py): up to the 180s
# turn cap, or the 570s condense cap, then the ordinary ≤90s shutdown. 570 + 90 = 660.
# Same rationale and numbers as the local unit.
TimeoutStopSec=660
# mixed, NOT control-group: control-group SIGTERMs every live claude child in
# parallel with the daemon, so their turns die with exit 143 BEFORE stop() can
# set _shutting_down — each was persisted as needs_attention and survived the
# restart as a spurious "Turn failed" card (2026-08-29). mixed SIGTERMs only the
# daemon; orchestrator.stop() then tears children down in order, and the final
# SIGKILL phase still sweeps the whole cgroup at TimeoutStopSec.
KillMode=mixed
# Sized for rocky's 31 GB, versus 10G/12G on dobby's 19 GB host. Memory headroom is
# the main reason for offloading sessions here in the first place.
MemoryHigh=24G
# Shared with every `codex app-server` this runner supervises (one per ACCOUNT,
# ref-counted and idle-reaped after CCSWITCH_CODEX_IDLE_GRACE_S).
MemoryMax=28G
# TasksMax counts threads: this daemon owns every live claude session plus its MCP
# fleet, Xvfb and thread pools. MemoryMax is the real backstop.
TasksMax=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
Alias=ccswitch-daemon.service
