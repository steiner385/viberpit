[Unit]
# Establishes the sshfs mounts rocky needs from dobby (spec decision 4: dobby is
# canonical for the account store, the shared ~/.claude assets, and the archive dir).
# Without these the daemon starts but every session fails — no credentials, the wrong
# skill set, and archiving dies with Permission denied on /mnt/hdd-storage.
#
# Install ON THE REMOTE SESSION HOST (rocky) as viberpit-mounts.service.
Description=ViberPit remote mounts from dobby (account store, shared .claude, archives)
After=network-online.target tailscaled.service
Wants=network-online.target
# The mounts ride the tailnet, so tailscaled must be up first.
Requires=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Run as tony, NOT root: sshfs must use tony's own ssh key and known_hosts.
User=tony
ExecStart=/home/tony/bin-viberpit-mounts.sh
ExecStop=/bin/bash -c "for p in /mnt/hdd-storage /home/tony/.claude /home/tony/.claude-accounts /home/tony/avd-golden; do fusermount -u \"$p\" 2>/dev/null || true; done"
# A transient network hiccup at boot should not permanently fail the unit. Note the
# script ALSO retries internally (2026-08-26 outage): tailscaled is often still
# settling on the first run, and a unit-level failure here cancels the daemon's start
# job outright. This Restart= is the outer net for the case the inner retries exhaust.
Restart=on-failure
RestartSec=10
# Must exceed the script's worst case: 4 paths x CCSWITCH_MOUNT_ATTEMPTS (5) x
# CCSWITCH_MOUNT_RETRY_DELAY (3s) plus sshfs connect time. Without this systemd's
# 90s default would SIGKILL the script mid-retry and re-introduce the very race the
# retry loop exists to close.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
Alias=ccswitch-mounts.service
