[Unit]
Description=ccswitch deploy controller (poll origin/master + user-triggered deploys)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tony
EnvironmentFile=/etc/ccswitch/ccswitch.env
# Paths match the sibling units (ccswitch.service / ccswitch-daemon.service). Adjust
# the checkout path at install time if this host's deploy checkout differs (e.g. the
# live host uses .../cc-account-switcher-deploy). serve.py defaults CCSWITCH_DEPLOY_REPO
# to WorkingDirectory, so keep the two in sync.
WorkingDirectory=/home/tony/GitHub/cc-account-switcher-deploy
Environment=CCSWITCH_DEPLOY_REPO=/home/tony/GitHub/cc-account-switcher-deploy
RuntimeDirectory=ccswitch
RuntimeDirectoryPreserve=yes
ExecStart=/home/tony/GitHub/cc-account-switcher-deploy/.venv/bin/python -m server.deploy serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
