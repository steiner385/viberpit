# Recovers the ONE failure mode systemd's Restart= policy cannot: a start job that
# was CANCELLED before the process ever ran.
#
# ccswitch-daemon.service has `Requires=ccswitch-mounts.service`. When that mount
# unit is not ready at boot, systemd cancels the daemon's start job outright —
# `Job ccswitch-daemon.service/start failed with result 'dependency'` — and the unit
# then sits inactive forever. `Restart=always` never engages, because it only
# restarts a process that actually started and exited.
#
# On 2026-08-25 that cost 45 minutes: the sshfs mount recovered on its own minutes
# after boot, but nothing ever retried the daemon (#765).
#
# This deliberately does NOT duplicate Restart=always. A daemon that runs and dies is
# already covered. This only asks: "is it inactive when it should be running?"
[Unit]
Description=Ensure ccswitch-daemon is running after a cancelled start job
Documentation=https://github.com/steiner385/cc-account-switcher
After=ccswitch-mounts.service

[Service]
Type=oneshot
SyslogIdentifier=ccswitch-daemon-ensure
# Guard on the mount unit, not just on the daemon being down. Starting the daemon
# into a dead sshfs mount is what killed it in the first place (OSError EIO on
# ~/.claude-accounts), so a down daemon plus down mounts is a state to leave alone
# and let the mount unit fix.
ExecStart=/bin/sh -c '\
  if systemctl is-active --quiet ccswitch-daemon.service; then exit 0; fi; \
  if ! systemctl is-active --quiet ccswitch-mounts.service; then \
    echo "daemon down but mounts not ready — leaving it to ccswitch-mounts.service"; exit 0; \
  fi; \
  echo "daemon inactive with mounts healthy — starting (see #765)"; \
  systemctl start ccswitch-daemon.service'
