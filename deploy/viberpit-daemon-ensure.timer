# Pairs with viberpit-daemon-ensure.service. See that unit for why this exists.
[Unit]
Description=Check every 60s that viberpit-daemon did not stay dead after a cancelled start job
Documentation=https://github.com/steiner385/viberpit

[Timer]
# OnBootSec is deliberately short: the boot race this fixes happens seconds after
# boot, and every minute it goes unnoticed is a minute of outage.
OnBootSec=45
OnUnitActiveSec=60
AccuracySec=10s
Unit=viberpit-daemon-ensure.service

[Install]
WantedBy=timers.target
Alias=ccswitch-daemon-ensure.timer
