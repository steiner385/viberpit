# ViberPit HTTPS vhost — tailnet-only (dobby.tail0dd570.ts.net)
# Install: ln -sf /etc/nginx/sites-available/viberpit-tailnet /etc/nginx/sites-enabled/
# Cert: provisioned by tailscale cert (see viberpit-cert-renew.service)
# Needs: deploy/viberpit-log-formats.nginx in /etc/nginx/conf.d/ (defines viberpit_redacted;
#        `nginx -t` fails loudly without it)

server {
    listen 443 ssl;
    server_name dobby.tail0dd570.ts.net;

    ssl_certificate     /etc/viberpit/dobby.tail0dd570.ts.net.crt;
    ssl_certificate_key /etc/viberpit/dobby.tail0dd570.ts.net.key;

    # Anti-spoofing: strip any client-supplied Tailscale identity headers.
    # nginx sets these to empty before forwarding, so clients cannot inject
    # a fake identity. The app's X-Real-IP whois fallback relies on this.
    proxy_set_header Tailscale-User-Login   "";
    proxy_set_header X-Tailscale-User-Login "";

    # Pass the real Tailscale peer IP so the whois identity fallback works
    # when Tailscale-User-Login is not present.
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite, never pass through, X-Forwarded-For: the edge rewrites request.client
    # from it for a 127.0.0.1 peer, and whois then identifies that address. A client
    # value here let any tailnet device pick the identity (#3010).
    proxy_set_header X-Forwarded-For $remote_addr;

    # WebSocket upgrade — required for xterm.js terminal and VNC bridge.
    # Timeout set to 24 h; sessions stay open indefinitely.
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;

    # The one-tap MCP sign-in callback carries the provider's authorization code and
    # state in its query string: log it without $args (format in viberpit-log-formats).
    # No proxy_set_header here, so the server-level identity headers above still apply.
    location = /api/mcp/oauth/callback {
        access_log /var/log/nginx/access.log viberpit_redacted;
        proxy_pass http://127.0.0.1:8787;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
    }
}
