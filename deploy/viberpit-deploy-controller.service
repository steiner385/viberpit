[Unit]
Description=ViberPit deploy controller (poll origin/master + user-triggered deploys)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
SyslogIdentifier=viberpit-deploy-controller
User=tony
EnvironmentFile=/etc/viberpit/viberpit.env
# Paths match the sibling units (viberpit.service / viberpit-daemon.service). Adjust
# the checkout path at install time if this host's deploy checkout differs (e.g. the
# live host uses .../viberpit-deploy). serve.py defaults VIBERPIT_DEPLOY_REPO
# to WorkingDirectory, so keep the two in sync.
WorkingDirectory=/home/tony/GitHub/viberpit-deploy
Environment=VIBERPIT_DEPLOY_REPO=/home/tony/GitHub/viberpit-deploy
RuntimeDirectory=viberpit
RuntimeDirectoryPreserve=yes
ExecStart=/home/tony/GitHub/viberpit-deploy/.venv/bin/python -m server.deploy serve
Restart=on-failure
RestartSec=5
# Memory backstop. Unbounded, a per-tick heap leak (a fresh CA bundle per httpx client,
# server/http_tls.py) grew this process to VmSize 4.7 GB in 11 days on dobby (2026-11-24),
# 4.2 GB of it in swap. Sized from a real deploy: the controller idles at ~170-250 MB and
# `npm run build` (tsc + vite) runs in this cgroup at a measured 1.37 GB peak. Above
# MemoryHigh the kernel throttles and reclaims; at MemoryMax it OOM-kills, and
# Restart=on-failure brings the controller back (its status file survives the restart).
MemoryHigh=2G
MemoryMax=3G
# MemoryMax counts RAM only. Leaked pages are never touched again, so they swap out and
# never reach it: the 2026-11-24 process sat at 51 MB RSS with 4.2 GB swapped. Capping
# swap makes a leak hit MemoryMax instead of filling the host's swap.
MemorySwapMax=1G

[Install]
WantedBy=multi-user.target
Alias=ccswitch-deploy-controller.service
