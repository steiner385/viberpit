[Unit]
Description=ViberPit session daemon — owns live claude sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=viberpit-daemon
User=tony
RuntimeDirectory=viberpit
RuntimeDirectoryPreserve=yes
# Persistent state dir owned by User= (creates /var/lib/viberpit). The deploy
# snapshot/restore (issue: user-controlled deploy) writes the live-session snapshot
# under here; without it the non-root daemon can't create /var/lib/viberpit and
# snapshot_deploy fails with PermissionError.
StateDirectory=viberpit
# Per-HOST log dir, created and chowned to User= by systemd (/var/log/viberpit).
# Without it the non-root daemon cannot write under /var/log and the log dir
# default fell through to ~/.claude-accounts/logs — the sshfs-SHARED account
# store, so rocky's daemon and dobby's edge appended to and independently
# rotated ONE log file over FUSE, and #1009's daemon logs were unrecoverable
# (#1010). server/obs/logdir.py picks this first.
LogsDirectory=viberpit
WorkingDirectory=/home/tony/GitHub/viberpit-deploy
EnvironmentFile=/etc/viberpit/viberpit.env
# Where per-account CODEX_HOMEs land: /var/lib/viberpit/state/ccswitch/codex.
# `codex app-server` keeps SQLite + WAL, thread state and shell history under
# CODEX_HOME, and the plan forbids that on a network filesystem — the 2026-09-03
# sshfs torn-read incident (#1005) is what a shared mount does to a file format
# that assumes local locking. Pinning it to StateDirectory= makes locality a
# property of the unit instead of a hope about where $HOME/.local/state resolves
# on a given runner. XDG_STATE_HOME has exactly ONE reader in this repo
# (server/codex/manager.py:default_codex_home_base), so this moves nothing else.
# The daemon refuses to start a runner whose home is not provably local anyway
# (process.assert_local_filesystem), and `python -m server.codex.doctor` reports
# it as `runtime_home` before it costs anyone a session.
Environment=XDG_STATE_HOME=%S/viberpit/state
# This entrypoint calls uvicorn.run() programmatically (server/ipc/serve.py) rather
# than the uvicorn CLI, so --timeout-graceful-shutdown can't be passed here as a
# flag; it's set as timeout_graceful_shutdown=10 in that call instead (same
# transcript-audit V4 rationale as viberpit.service: bound SIGTERM so the daemon
# lifespan shutdown — x11 teardown, reauth shutdown, orchestrator stop — actually
# runs instead of being SIGKILLed).
# Boot-time version reconcile (spec: fleet deploy fan-out §3): fast-forward this checkout to
# deploy_state.deployed_sha when it is behind. Always exits 0 — a runner that cannot
# reconcile still starts; the edge's skew gate keeps it out of dispatch until fixed.
# The leading `-` makes systemd IGNORE a non-zero exit AND a missing module: a checkout that
# predates server/deploy/runner_sync.py — the bootstrap window before this commit is deployed,
# or a rollback that rewinds across it — would otherwise fail ExecStartPre and never start
# the daemon at all.
ExecStartPre=-/home/tony/GitHub/viberpit-deploy/.venv/bin/python -m server.deploy.runner_sync --repo /home/tony/GitHub/viberpit-deploy
ExecStart=/home/tony/GitHub/viberpit-deploy/.venv/bin/python -m server.ipc
# Startup budget: the ExecStartPre reconcile can fetch (60s) + pip install (600s) + sync (120s)
# before ExecStart even begins, well past systemd's 90s default.
TimeoutStartSec=900
# Restart=always, NOT on-failure: an out-of-band SIGTERM (a stray kill/pkill, not a
# `systemctl stop`) makes the daemon exit with Result=success, which on-failure does
# NOT restart — the daemon then stays dead, the edge loops on "Connection refused",
# and the UI shows no sessions. The health watchdog only covers the wedge case
# (process alive, socket dead), so a fully-absent daemon fell between both guards.
# `always` still honors an explicit `systemctl stop` (deploys are unaffected), and
# StartLimitBurst/Interval still backstops a genuine crash-loop.
Restart=always
RestartSec=3
# Shutdown budget. SIGTERM first DRAINS in-flight turns (server/ipc/drain_on_signal.py,
# 2026-08-30: a bare `systemctl restart` killed five sessions mid-turn) — up to
# VIBERPIT_DRAIN_TURN_CAP_SEC (180s) for an ordinary turn, or
# VIBERPIT_DRAIN_CONDENSE_CAP_SEC (570s) while a session is mid-compaction — and only
# then begins the ordinary shutdown: 10s (uvicorn graceful) + up to 15s (x11.stop_all
# sweep, _DAEMON_SHUTDOWN_SWEEP_TIMEOUT_S in serve.py) + reauth shutdown/orchestrator
# stop. 570 + 90 = 660. An idle daemon still stops in seconds; a WEDGED one (loop not
# running, so the drain never starts) is what the health watchdog escalates with
# SIGKILL after VIBERPIT_DRAIN_WAIT rather than waiting this out.
TimeoutStopSec=660
# mixed, NOT control-group: control-group SIGTERMs every live claude child in
# parallel with the daemon, so their turns die with exit 143 BEFORE stop() can
# set _shutting_down — each was persisted as needs_attention and survived the
# restart as a spurious "Turn failed" card (2026-08-29). mixed SIGTERMs only the
# daemon; orchestrator.stop() then tears children down in order, and the final
# SIGKILL phase still sweeps the whole cgroup at TimeoutStopSec.
KillMode=mixed
# Shared with every `codex app-server` this daemon supervises (one per ACCOUNT,
# not per session — server/codex/manager.py ref-counts them and reaps after
# VIBERPIT_CODEX_IDLE_GRACE_S). Watch codex_threads_active / codex_turns_active
# before raising this: a climbing app-server count with no turns means the idle
# reaper is not firing, which is a bug to fix rather than headroom to buy.
# Percent of host RAM, not absolute, so one unit sizes itself on any host (dobby's
# 19 GB → ~12.4G; a 31 GB host → ~20G). This unit runs on a DESKTOP host: the rest is the
# desktop's, and a 15G drop-in on dobby's 19 GB left so little that session test runs
# OOM-killed Chrome (2026-10-09). Headless runners use viberpit-daemon-remote.service.
MemoryMax=65%
# Soft limit below MemoryMax: here the kernel applies reclaim pressure and throttles
# the cgroup instead of OOM-killing inside it at MemoryMax. Gives a restart-storm of
# relaunched session+MCP fleets a chance to bleed off. The health watchdog
# (viberpit-health.timer) alerts before MemoryMax is reached.
MemoryHigh=55%
# continue, NOT the default stop (#2673). With stop, systemd stops the WHOLE unit when the
# kernel OOM-kills ANY process in its cgroup — at MemoryMax or on a host-wide OOM alike.
# This daemon supervises every live session, so on 2026-10-04 one session's 5.9 GB `node`
# build was killed in a global OOM and systemd then drained and SIGKILLed every other
# session with it. By then the victim's memory is already freed, so stopping the siblings
# recovers nothing. With continue only the victim dies (its session sees the tool fail);
# if the victim is the daemon process itself it exits and Restart=always recovers it.
# The daemon also raises every session subtree's oom_score_adj to
# VIBERPIT_SESSION_OOM_SCORE_ADJ (default 500, 0 disables; server/sessions/memory_watch.py),
# so a host-wide OOM picks a session's runaway tool over the daemon and desktop apps.
OOMPolicy=continue
# No pids ceiling: this daemon owns every live claude session, and each spawns a
# Claude CLI + its MCP-server fleet + Xvfb + thread pools. TasksMax counts threads
# too, so a low cap is hit fast (512 throttled ~900x in prod → fork/thread EAGAIN,
# SIGABRT'd subprocesses, dead turns). MemoryMax is the real backstop.
TasksMax=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
Alias=ccswitch-daemon.service
